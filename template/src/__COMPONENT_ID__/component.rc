#include "resource.h"
#include <windows.h>

IDD_COMPONENT_PREFERENCES DIALOGEX 0, 0, 276, 78
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    GROUPBOX        "General", -1, 7, 7, 262, 64
    CONTROL         "Enable component", IDC_ENABLE_COMPONENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 22, 126, 12
    LTEXT           "__DESCRIPTION__", IDC_COMPONENT_DESCRIPTION, 17, 41, 240, 20
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION __VERSION_COMMAS__
 PRODUCTVERSION __VERSION_COMMAS__
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "__DISPLAY_NAME__ contributors"
            VALUE "FileDescription", "__DISPLAY_NAME__ foobar2000 component"
            VALUE "FileVersion", "__VERSION__.0"
            VALUE "InternalName", "__COMPONENT_ID__"
            VALUE "OriginalFilename", "__COMPONENT_ID__.dll"
            VALUE "ProductName", "__DISPLAY_NAME__"
            VALUE "ProductVersion", "__VERSION__.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
